# Reglas udev del banco remoto: acceso SIN root para el grupo plugdev a los
# programadores ST-Link y al bootloader USB DFU de ST, y al grupo gpio para
# los /dev/gpiochipN (libgpiod). Se instala en /etc/udev/rules.d/.

# --- ST-Link (VID 0483) ---
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3744", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3748", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374b", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374d", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374e", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374f", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3752", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3753", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3754", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3755", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3757", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# --- Bootloader USB DFU de ST (System Memory) ---
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="df11", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# --- Programadores ISP para AVR (avrdude -c usbasp / -c usbtiny) ---
SUBSYSTEM=="usb", ATTR{idVendor}=="16c0", ATTR{idProduct}=="05dc", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1781", ATTR{idProduct}=="0c9f", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# --- Hubs USB: uhubctl corta y da energía a sus puertos (Alimentación USB en la web) ---
SUBSYSTEM=="usb", DRIVER=="usb", ATTR{bDeviceClass}=="09", MODE="0664", GROUP="plugdev"

# --- GPIO (character device, usado por libgpiod para BOOT0/NRST) ---
SUBSYSTEM=="gpio", KERNEL=="gpiochip*", GROUP="gpio", MODE="0660"

# Los puertos serie (/dev/ttyACM*, /dev/ttyUSB*) ya son del grupo dialout:
# ahí aparecen los ESP32 (CP210x/CH340/USB-JTAG) y los Arduino (ATmega16U2, 32U4).
