# Variables de entorno del servicio (se instala como /etc/stm32-bench/bench.env,
# permisos 640 root:stm32bench). install.sh lo genera automáticamente.

# Usuario y hash de contraseña. Generar el hash con:
#   /opt/stm32-bench/.venv/bin/python /opt/stm32-bench/scripts/hash_password.py
BENCH_USER=admin
BENCH_PASSWORD_HASH=

# Clave para firmar la cookie de sesión (32+ bytes aleatorios):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BENCH_SECRET_KEY=

# Directorios
BENCH_CONFIG_DIR=/etc/stm32-bench
BENCH_PROJECTS_DIR=/srv/stm32-bench/proyectos
BENCH_STATE_DIR=/var/lib/stm32-bench

# Servidor web. 0.0.0.0 + allowed_networks (bench.yaml) limita a Tailscale.
BENCH_HOST=0.0.0.0
BENCH_PORT=8080

# 1 = cookie solo por HTTPS (activar si ponés un proxy HTTPS / tailscale serve)
BENCH_COOKIE_SECURE=0

# 1 = modo simulación (sin hardware). Solo para desarrollo.
BENCH_MOCK=0
